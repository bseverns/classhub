msgid "Join Class"
msgstr "နုာ်လီၤတီၤ"

msgid "Skip to main content"
msgstr "ဃ့ၢ်ကပၤဆူ တၢ်ဂ့ၢ်မိၢ်ပှၢ်"

msgid "Join your class"
msgstr "နုာ်လီၤလၢ နတီၤ"

msgid "Enter your class code and pick a display name."
msgstr "ကွဲးထီၣ် နတီၤအကီၢ် ဒီးဃုထၢ နမံၤလၢကဒုးနဲၣ်."

msgid "Enter the class code from your teacher. Pick any display name you like."
msgstr "ကွဲးထီၣ် တီၤအကီၢ်လၢ နဆရာ/မ အအိၣ်. ဃုထၢမံၤလၢ နသးခုတမံၤမံၤ."

msgid "On shared devices, enter your return code so you do not join as another student."
msgstr "ဖဲ device လၢ ပှၤသုံးသကိးအီၤအခါ, ကွဲးထီၣ် နက့ၤနုာ်အကီၢ် ဒ်သိးနတနုာ်လီၤဒ် ပှၤမၤလိအဂၤအသိးတဂ့ၤ."

msgid "Same classroom device? You can usually leave return code blank."
msgstr "မ့ၢ် classroom device တခါဃီဧါ. နပာ်က့ၤ return code လၢအလီၢ်ဟးဂီၤတသ့ၣ်တဘျီန့ၣ်သ့."

msgid "On shared devices, use your own return code to avoid signing in as someone else."
msgstr "ဖဲ device လၢ ပှၤသုံးသကိးအီၤအခါ, သုံးနက့ၤနုာ်အကီၢ်ဒၣ်နဲ ဒ်သိး နတနုာ်လီၤဒ် ပှၤဂၤအသိးတဂ့ၤ."

msgid "Class code"
msgstr "တီၤအကီၢ်"

msgid "Your display name"
msgstr "နမံၤလၢကဒုးနဲၣ်"

msgid "A nickname or made-up name is fine — no need to use your real name."
msgstr "မံၤဖိ မ့တမ့ၢ် မံၤလၢနဒုးဘၣ်အသးတမံၤန့ၣ် သ့ဝဲ. တလီၤဘၣ်လၢ ကဘၣ်သုံး နမံၤအမှန်တက့ၢ်ဘၣ်."

msgid "Return code (optional)"
msgstr "က့ၤနုာ်အကီၢ် (သဘျ့)"

msgid "If your class uses icon codes, use the icon keypad below."
msgstr "မ့ၢ်နတီၤ သုံး icon code တဖၣ်န့ၣ်, သုံး icon keypad လၢအဖီလာ်."

msgid "Show icon keypad"
msgstr "ဒုးနဲၣ် icon keypad"

msgid "Clear return code"
msgstr "မၤစှၤကွံာ် က့ၤနုာ်အကီၢ်"

msgid "Return code icon keypad"
msgstr "က့ၤနုာ်အကီၢ် icon keypad"

msgid "Join class"
msgstr "နုာ်လီၤတီၤ"

msgid "Privacy at a glance:"
msgstr "တၢ်ခူသူၣ် တၢ်ကွၢ်ဖျါတဘျီ:"

msgid "We store your display name, class submissions, and event timestamps."
msgstr "ပသိမ်းဆည်း နမံၤလၢကဒုးနဲၣ်, class submission တဖၣ်, ဒီး event timestamp တဖၣ်."

msgid "Storage location: %(location)s"
msgstr "တၢ်သိမ်းဆည်းအလီၢ်: %(location)s"

msgid "Retention:"
msgstr "တၢ်သိမ်းအဆၢကတီၢ်:"

msgid "submissions are kept up to %(counter)s day unless deleted sooner."
msgid_plural "submissions are kept up to %(counter)s days unless deleted sooner."
msgstr[0] "submission တဖၣ် ဘၣ်တၢ်သိမ်းဆည်းအီၤ တုၤ %(counter)s သီ, ဖဲတဘၣ်ဖျီၣ်ကွံာ်အီၤအဆိတဒံးဘၣ်."

msgid "submissions stay until a teacher or admin removes them."
msgstr "submission တဖၣ် အိၣ်ဆိးတုၤ ဆရာ/မ မ့တမ့ၢ် admin ဖျီၣ်ကွံာ်အီၤ."

msgid "Delete now: after joining, open <a href=\"/student/my-data\">My Data</a> to delete your work or end this device session."
msgstr "ဖျီၣ်ကွံာ်ခဲအံၤ: ဖဲနနုာ်လီၤဝံၤအလီၢ်ခံ, အိးထီၣ် <a href=\"/student/my-data\">ယ Data</a> ဒ်သိးကဖျီၣ်ကွံာ် နတၢ်မၤ မ့တမ့ၢ် မၤဝံၤ device session အံၤ."

msgid "Teacher? Use <a href=\"/teach\">/teach</a>."
msgstr "မ့ၢ်ဆရာ/မဧါ. သုံး <a href=\"/teach\">/teach</a>."

msgid "Teacher Login"
msgstr "ဆရာ/မ အတၢ်နုာ်လီၤ"

msgid "Home"
msgstr "အခီၣ်ထံး"

msgid "Sign in to your account"
msgstr "နုာ်လီၤဆူ န account"

msgid "Log in"
msgstr "နုာ်လီၤ"

msgid "Language"
msgstr "ကျိာ်"

msgid "Switch"
msgstr "လဲၤလိာ်"

msgid "That invite link is not valid."
msgstr "invite link အံၤ တဘၣ်ဝဲဘၣ်."

msgid "That invite link has been disabled."
msgstr "invite link အံၤ ဘၣ်တၢ်ပတုာ်အီၤလံ."

msgid "That invite link has expired."
msgstr "invite link အံၤ အဆၢကတီၢ်လဲၤပူၤလံ."

msgid "This invite is full right now. Ask your teacher for a new invite link."
msgstr "invite အံၤ ပှဲၤလံခဲအံၤ. ဃ့နဆရာ/မ လၢ invite link အသီတခါ."

msgid "That invite link is not usable right now."
msgstr "invite link အံၤ သုံးတသ့ဒံးဘၣ် ခဲအံၤ."

msgid "That looks like an email address. Please use a nickname or display name instead."
msgstr "အဝဲန့ၣ် ထံၣ်လီၤအသးဒ် email address အသိး. သုံးမံၤဖိ မ့တမ့ၢ် မံၤလၢကဒုးနဲၣ်အီၤတက့ၢ်."

msgid "That looks like a phone number. Please use a nickname or display name instead."
msgstr "အဝဲန့ၣ် ထံၣ်လီၤအသးဒ် phone number အသိး. သုံးမံၤဖိ မ့တမ့ၢ် မံၤလၢကဒုးနဲၣ်အီၤတက့ၢ်."

msgid "Please use a nickname or display name instead of personal information."
msgstr "သုံးမံၤဖိ မ့တမ့ၢ် မံၤလၢကဒုးနဲၣ်အီၤ, အလီၢ်တခါလၢ personal information တက့ၢ်."

msgid "Heads-up: that looks like an email address. A nickname is safer."
msgstr "သ့ၣ်ညါတက့ၢ်: အဝဲန့ၣ် ထံၣ်လီၤအသးဒ် email address အသိး. မံၤဖိတမံၤ ပူၤဖျဲးဒိၣ်ထီၣ်."

msgid "Heads-up: that looks like a phone number. A nickname is safer."
msgstr "သ့ၣ်ညါတက့ၢ်: အဝဲန့ၣ် ထံၣ်လီၤအသးဒ် phone number အသိး. မံၤဖိတမံၤ ပူၤဖျဲးဒိၣ်ထီၣ်."

msgid "Consider using a nickname instead of personal information."
msgstr "ဆိကမိၣ်သုံး မံၤဖိတမံၤ အလီၢ်တခါလၢ personal information တက့ၢ်."

msgid "You are joining <strong>%(class_name)s</strong> by invite link."
msgstr "နကနုာ်လီၤဆူ <strong>%(class_name)s</strong> ခီဖျိ invite link."

msgid "Storage location:"
msgstr "တၢ်သိမ်းဆည်းအလီၢ်:"

msgid "day(s). Deleted sooner on request."
msgstr "သီ. မ့ၢ်ဃ့န့ၣ် ဖျီၣ်ကွံာ်အဆိသ့."

msgid "Delete now:"
msgstr "ဖျီၣ်ကွံာ်ခဲအံၤ:"

msgid "My Data"
msgstr "ယ Data"

msgid "delete your work or end session."
msgstr "ဖျီၣ်ကွံာ် နတၢ်မၤ မ့တမ့ၢ် မၤဝံၤ session."

msgid "Student home"
msgstr "ပှၤမၤလိ အခီၣ်ထံး"

msgid "Join page"
msgstr "နုာ်လီၤအလံာ်ကဘျံး"

msgid "Export my portfolio"
msgstr "ထုးထီၣ်ယ portfolio"

msgid "Privacy"
msgstr "တၢ်ခူသူၣ်"

msgid "Signed in as"
msgstr "နုာ်လီၤဒ်"

msgid "Code"
msgstr "ကီၢ်"

msgid "Copy class code"
msgstr "ကူးယူ တီၤအကီၢ်"

msgid "Your return code:"
msgstr "နက့ၤနုာ်အကီၢ်:"

msgid "Show return code"
msgstr "ဒုးနဲၣ် က့ၤနုာ်အကီၢ်"

msgid "Hide return code"
msgstr "ခူသူၣ် က့ၤနုာ်အကီၢ်"

msgid "Show"
msgstr "ဒုးနဲၣ်"

