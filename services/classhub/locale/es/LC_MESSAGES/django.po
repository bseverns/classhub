# ── Invite join (blocktrans) ─────────────────────────────────────────
#

#, python-format
msgid "You are joining <strong>%(class_name)s</strong> by invite link."
msgstr "Te estás uniendo a <strong>%(class_name)s</strong> por enlace de invitación."

msgid "Storage location:"
msgstr "Ubicación del almacenamiento:"

msgid "day(s). Deleted sooner on request."
msgstr "día(s). Se eliminan antes si se solicita."

msgid "Delete now:"
msgstr "Eliminar ahora:"

msgid "My Data"
msgstr "Mis datos"

msgid "delete your work or end session."
msgstr "eliminar tu trabajo o terminar sesión."

