[Unit]
Description=ClassHub private Ollama server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/classhub/llm-server.env
ExecStart=/bin/bash /opt/classhub-llm/run-ollama.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
