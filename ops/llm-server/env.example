# Copy to /etc/classhub/llm-server.env on the Thundercompute vGPU node.

# Host identity
CLASSHUB_LLM_NODE_NAME=thundercompute-vgpu-1
TAILSCALE_TAGS=tag:llm

# Shared private API key.
# Required by the LMS helper when using the private proxy or vLLM.
LLM_SHARED_API_KEY=REPLACE_ME_STRONG

# Ollama mode
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=15m

# Optional Caddy private wrapper
PRIVATE_PROXY_CADDYFILE=/opt/classhub-llm/Caddyfile.private
PRIVATE_PROXY_LISTEN=127.0.0.1:8443
UPSTREAM_OLLAMA=http://127.0.0.1:11434
UPSTREAM_VLLM=http://127.0.0.1:8000

# vLLM mode
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
VLLM_MAX_MODEL_LEN=4096
CUDA_VISIBLE_DEVICES=0
