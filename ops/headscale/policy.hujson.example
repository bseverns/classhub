{
  // Narrow default tag ownership for the createMPLS private helper path.
  "groups": {
    "group:ops": [
      "ops@creatempls.org"
    ]
  },

  "tagOwners": {
    "tag:classhub-lms": ["group:ops"],
    "tag:thundercompute-gpu": ["group:ops"],
    "tag:ops": ["group:ops"]
  },

  "acls": [
    {
      "action": "accept",
      "src": ["tag:classhub-lms"],
      "dst": ["tag:thundercompute-gpu:443"]
    },
    {
      "action": "accept",
      "src": ["tag:ops"],
      "dst": ["tag:classhub-lms:22", "tag:thundercompute-gpu:22"]
    }
  ],

  "autoApprovers": {
    "routes": {}
  }
}
