HEADSCALE_IMAGE=headscale/headscale:0.26.1
CADDY_IMAGE=caddy:2.10.2

# Public control-plane hostname for Jetson_B / Headscale.
HEADSCALE_SERVER_NAME=hs.creatempls.org

# Optional email for ACME registration.
CADDY_ACME_EMAIL=ops@creatempls.org

# Local metrics bind on the Headscale host.
HEADSCALE_METRICS_BIND=127.0.0.1:9090
