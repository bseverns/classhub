# ClassHub -> lab_mind Jetson-B private LLM backend.
#
# Append these values to compose/.env after the LMS host and Jetson-B are
# enrolled in Headscale and the Jetson has published its model API on a
# tailnet-only HTTPS name.
#
# This keeps student/teacher browsers on the public LMS domain. Only Homework
# Helper talks to the Jetson endpoint.

COMPOSE_LOCAL_OLLAMA_AUTO=0
LLM_ENABLED=1
LLM_BACKEND=openai_compatible
LLM_BASE_URL=https://jetson-b.tail.creatempls.org
LLM_API_KEY=REPLACE_ME_WITH_PRIVATE_MODEL_TOKEN
LLM_MODEL=REPLACE_ME_WITH_LLAMA_CPP_MODEL_ID
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_LOG_PROMPT_CONTENT=0
LLM_REDACTION_ENABLED=1
LLM_HEALTHCHECK_ENABLED=1
HELPER_REMOTE_MODE_ACKNOWLEDGED=1

# Compatibility fallback for older helper paths. New config should prefer LLM_*.
OLLAMA_BASE_URL=https://jetson-b.tail.creatempls.org
OLLAMA_API_KEY=REPLACE_ME_WITH_PRIVATE_MODEL_TOKEN
OLLAMA_MODEL=REPLACE_ME_WITH_LLAMA_CPP_MODEL_ID

# Optional: use the Jetson only for bounded staff-activated remote compute.
# This requires an operator bridge for activate/health/stop before enabling.
# REMOTE_LLM_BASE_URL=https://jetson-b.tail.creatempls.org
# REMOTE_LLM_API_KEY=REPLACE_ME_WITH_PRIVATE_MODEL_TOKEN
# REMOTE_LLM_MODEL=REPLACE_ME_WITH_LLAMA_CPP_MODEL_ID
