# Routing selector for Caddy template mounted by docker-compose.yml.
# - Caddyfile.local  = local/day-1 HTTP on localhost
# - Caddyfile.domain = real domain + automatic TLS via Caddy
# - Caddyfile.domain.assets = domain mode with separate asset host routing
CADDYFILE_TEMPLATE=Caddyfile.domain
# Optional additional static site at the same Caddy edge. To enable it, select
# Caddyfile.extra.static-site, provide one or more comma-separated public DNS
# hostnames, and point the host root at a directory containing index.html.
CADDY_EXTRA_CONFIG_TEMPLATE=Caddyfile.extra.empty
CADDY_STATIC_SITE_ROOT_HOST=./static-site.empty
CADDY_STATIC_SITE_DOMAINS=
# Optional co-hosted Memory Engine route through the external public_edge
# network. Select the memory-engine fragment and set its public hostname.
CADDY_PROXY_CONFIG_TEMPLATE=Caddyfile.proxy.empty
CADDY_MEMORY_ENGINE_DOMAIN=
CADDY_MEMORY_ENGINE_UPSTREAM=memory_engine_proxy:80
# Infrastructure image pins. Use exact version tags or digests; override only when intentionally upgrading.
CADDY_IMAGE=caddy:2.10.2
POSTGRES_IMAGE=postgres:16.8
REDIS_IMAGE=redis:7.4.2
OLLAMA_IMAGE=ollama/ollama:0.5.7
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
# Optional hardening: set true only after validating deploy/smoke on your host.
CADDY_READ_ONLY=false
# Runtime UID/GID for classhub_web and helper_web containers.
# Set to your deploy user ids so host-mounted volumes (for example /uploads) stay writable.
APP_UID=1000
APP_GID=1000

# Domain is used by Caddyfile.domain. Keep placeholder until DNS is ready.
DOMAIN=lms.example.org
ASSET_DOMAIN=assets.example.org
CADDY_CLASSHUB_MAX_BODY=220MB
CADDY_HELPER_MAX_BODY=1MB
CADDY_HSTS_MAX_AGE=31536000
# Production default: keep /upstream-healthz closed at the edge unless monitoring requires it.
CADDY_EXPOSE_UPSTREAM_HEALTHZ=0
# Optional teacher/admin edge armor.
# - IP allowlist applies to /admin* and /teach* routes.
# - Domain default is deny-by-default example ranges; replace with real operator IPs.
CADDY_STAFF_IP_ALLOWLIST_V4=203.0.113.10/32
CADDY_STAFF_IP_ALLOWLIST_V6=2001:db8::10/128
# Keep at 0 unless you intentionally expose staff routes publicly at the edge.
CADDY_ALLOW_PUBLIC_STAFF_ROUTES=0
# Optional extra gate for /admin* in Caddy (recommended in domain mode).
# Note: /admin/login* remains Django-only so staff can complete OTP login flow.
# SECURITY NOTE: this example keeps CADDY_ADMIN_BASIC_AUTH_ENABLED=1 intentionally.
# Until CADDY_ADMIN_BASIC_AUTH_USER and CADDY_ADMIN_BASIC_AUTH_HASH are set to real values,
# Caddy fail-closes /admin* and /teach* with 503 by design.
CADDY_ADMIN_BASIC_AUTH_ENABLED=1
CADDY_ADMIN_BASIC_AUTH_USER=
# Generate with: docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'strong-password'
# Compose interpolation note: bcrypt hashes contain '$'. Wrap value in single quotes
# or escape each '$' as '$$' to avoid "variable is not set" warnings.
CADDY_ADMIN_BASIC_AUTH_HASH=

POSTGRES_DB=classhub
POSTGRES_USER=classhub
POSTGRES_PASSWORD=REPLACE_ME_STRONG

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=REPLACE_ME_STRONG

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=REPLACE_ME_STRONG
# Dedicated signer for student same-device hint cookies.
# Must differ from DJANGO_SECRET_KEY when DJANGO_DEBUG=0.
DEVICE_HINT_SIGNING_KEY=REPLACE_ME_STRONG
# Dedicated signer for helper scope tokens shared between classhub and helper.
# Recommended: set distinct from DJANGO_SECRET_KEY for key separation.
HELPER_SCOPE_SIGNING_KEY=REPLACE_ME_STRONG
# Writable mounted curriculum root used by live admin coursepack imports.
CLASSHUB_CONTENT_ROOT=/content
DJANGO_TIME_ZONE=America/Chicago
DJANGO_ADMIN_2FA_REQUIRED=1
DJANGO_TEACHER_2FA_REQUIRED=1
# Teacher SSO rollout:
# - Google flow is shipped but stays off until explicitly enabled.
# - Microsoft/custom OIDC providers remain scaffolded and return "not active yet" notices.
CLASSHUB_TEACHER_SSO_ENABLED=0
CLASSHUB_TEACHER_SSO_ALLOW_PASSWORD_FALLBACK=1
# Signed state token max age (seconds) for teacher SSO callback.
CLASSHUB_TEACHER_SSO_STATE_MAX_AGE_SECONDS=600
# Comma-separated: google,microsoft,oidc_custom
CLASSHUB_TEACHER_SSO_PROVIDERS=
CLASSHUB_SSO_GOOGLE_CLIENT_ID=
CLASSHUB_SSO_GOOGLE_CLIENT_SECRET=
CLASSHUB_SSO_GOOGLE_ISSUER=https://accounts.google.com
CLASSHUB_SSO_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
CLASSHUB_SSO_GOOGLE_HOSTED_DOMAINS=
CLASSHUB_SSO_GOOGLE_ORG_AUTO_MAP=
CLASSHUB_SSO_MICROSOFT_CLIENT_ID=
CLASSHUB_SSO_MICROSOFT_CLIENT_SECRET=
CLASSHUB_SSO_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
CLASSHUB_SSO_MICROSOFT_DISCOVERY_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
CLASSHUB_SSO_MICROSOFT_TENANT_IDS=
CLASSHUB_SSO_MICROSOFT_ORG_AUTO_MAP=
CLASSHUB_SSO_OIDC_CUSTOM_CLIENT_ID=
CLASSHUB_SSO_OIDC_CUSTOM_CLIENT_SECRET=
CLASSHUB_SSO_OIDC_CUSTOM_ISSUER=
CLASSHUB_SSO_OIDC_CUSTOM_DISCOVERY_URL=
CLASSHUB_SSO_OIDC_CUSTOM_ALLOWED_DOMAINS=
CLASSHUB_SSO_OIDC_CUSTOM_ALLOWED_TENANT_IDS=
CLASSHUB_SSO_OIDC_CUSTOM_ORG_AUTO_MAP=
CSRF_TRUSTED_ORIGINS=https://lms.example.org
DJANGO_SESSION_COOKIE_DOMAIN=
DJANGO_CSRF_COOKIE_DOMAIN=
# Domain/TLS mode: keep secure cookies enabled.
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# CSP rollout mode:
# - relaxed: enforced relaxed policy + strict report-only policy
# - report-only: strict report-only policy only
# - strict: strict enforced policy only
# Domain/TLS production default enforces the no-inline-compatible strict policy.
DJANGO_CSP_MODE=strict
# Optional enforced CSP override. If set, this overrides mode-derived enforced CSP.
DJANGO_CSP_POLICY=
# Optional report-only CSP override. If set, this overrides mode-derived report-only CSP.
DJANGO_CSP_REPORT_ONLY_POLICY=
DJANGO_PERMISSIONS_POLICY=accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), usb=(), xr-spatial-tracking=()
DJANGO_X_FRAME_OPTIONS=SAMEORIGIN
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_EMAIL_TIMEOUT_SECONDS=10
DJANGO_DEFAULT_FROM_EMAIL=classhub@localhost
TEACHER_INVITE_FROM_EMAIL=classhub@localhost
TEACHER_2FA_INVITE_MAX_AGE_SECONDS=86400
TEACHER_2FA_DEVICE_NAME=teacher-primary
DJANGO_SECURE_SSL_REDIRECT=1
# HSTS is edge-owned in Caddy (CADDY_HSTS_MAX_AGE). Keep Django value at 0 unless intentionally overriding.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# Domain mode behind Caddy should trust forwarded headers from the first hop proxy.
REQUEST_SAFETY_TRUST_PROXY_HEADERS=1
REQUEST_SAFETY_XFF_INDEX=0
CLASSHUB_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CLASSHUB_ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=20
CLASSHUB_TEACHER_2FA_RATE_LIMIT_PER_MINUTE=10
CLASSHUB_HELPER_SIGNAL_WINDOW_HOURS=24
CLASSHUB_HELPER_SIGNAL_TOP_STUDENTS=5
# Domain/TLS production default: require active org membership for staff.
REQUIRE_ORG_MEMBERSHIP_FOR_STAFF=1
CLASSHUB_RBAC_SCOPED_GRANTS_ENABLED=0
# Keep approval workflow off for initial rollout; enable after smoke checks.
CLASSHUB_RBAC_POLICY_APPROVAL_REQUIRED=0
# Telemetry split rollout toggles (Phase 1). Keep defaults unless executing the split runbook.
# BASELINE EXAMPLE CONTRACT:
# - This domain example intentionally uses baseline telemetry defaults (`off` + `core`).
# - `check_runtime_policy_lock.py --profile release --env-file compose/.env.example.domain`
#   is expected to FAIL by design.
# - Release closeout requires temporary strict overrides in production `compose/.env`.
CLASSHUB_TELEMETRY_DATABASE_URL=
CLASSHUB_TELEMETRY_WRITE_MODE=off
CLASSHUB_TELEMETRY_READ_MODE=core
# Release-evidence runtime lock overrides (use only during cycle closeout evidence runs):
# - REQUIRE_ORG_MEMBERSHIP_FOR_STAFF=1
# - CLASSHUB_TELEMETRY_WRITE_MODE=dual
# - CLASSHUB_TELEMETRY_READ_MODE=telemetry
# Domain preset above keeps production-safe baseline defaults outside release sign-off runs.
CLASSHUB_CERTIFICATE_MIN_SESSIONS=8
CLASSHUB_CERTIFICATE_MIN_ARTIFACTS=6
# Optional short-lived cache for teacher tracker panels (seconds). Set 0 to disable.
CLASSHUB_TEACHER_PANEL_CACHE_TTL_SECONDS=0
CLASSHUB_SITE_MODE=normal
CLASSHUB_SITE_MODE_MESSAGE=
# Optional operator profile for white-label deployments (no template edits needed).
CLASSHUB_PRODUCT_NAME=Class Hub
CLASSHUB_OPERATOR_NAME=createMPLS
CLASSHUB_OPERATOR_DESCRIPTOR=a nonprofit educational group
# Optional explicit text override. If blank, generated from operator name + descriptor.
CLASSHUB_STORAGE_LOCATION_TEXT=
CLASSHUB_PRIVACY_PROMISE_TEXT=No tracking. No ads. No data broker sharing.
CLASSHUB_ADMIN_LABEL=createMPLS Course Admin
CLASSHUB_UPLOAD_MAX_MB=200
# Keep request timeout aligned with real upload expectations (60s is often too low on classroom Wi-Fi).
CLASSHUB_GUNICORN_TIMEOUT_SECONDS=1200
CLASSHUB_GUNICORN_WORKERS=2
CLASSHUB_UPLOAD_SCAN_ENABLED=0
CLASSHUB_UPLOAD_SCAN_COMMAND=clamscan --no-summary --stdout
CLASSHUB_UPLOAD_SCAN_TIMEOUT_SECONDS=20
CLASSHUB_UPLOAD_SCAN_FAIL_CLOSED=0
CLASSHUB_MARKDOWN_ALLOW_IMAGES=0
CLASSHUB_MARKDOWN_ALLOWED_IMAGE_HOSTS=
# Optional separate origin for lesson assets/videos rendered in lesson markdown.
# Leave blank to use same-origin links.
CLASSHUB_ASSET_BASE_URL=
# Program profile defaults: elementary, secondary (default), advanced.
CLASSHUB_PROGRAM_PROFILE=secondary
CLASSHUB_JOIN_RATE_LIMIT_PER_MINUTE=20
CLASSHUB_DEVICE_REJOIN_COOKIE_NAME=classhub_student_hint
CLASSHUB_DEVICE_REJOIN_MAX_AGE_DAYS=30
# Optional explicit override; secure default is 1 for every profile.
CLASSHUB_REQUIRE_RETURN_CODE_FOR_REJOIN=1
# Retention defaults are intentionally nonzero; set to 0 only when opting out explicitly.
CLASSHUB_SUBMISSION_RETENTION_DAYS=90
CLASSHUB_STUDENT_EVENT_RETENTION_DAYS=180
CLASSHUB_PORTFOLIO_FILENAME_MODE=generic
CLASSHUB_STUDENT_EVENT_IP_MODE=truncate
# Optional defaults for scripts/retention_maintenance.sh
RETENTION_SUBMISSION_DAYS=90
RETENTION_EVENT_DAYS=180
RETENTION_EVENT_EXPORT_DIR=/uploads/retention_exports
RETENTION_HELPER_EXPORT_DAYS=30
RETENTION_HELPER_EXPORT_DIR=/uploads/helper_reset_exports
RETENTION_SCAVENGE_MODE=report
RETENTION_ALERT_WEBHOOK_URL=
RETENTION_ALERT_ON_SUCCESS=0
REMOTE_COMPUTE_ALERT_WEBHOOK_URL=
REMOTE_COMPUTE_ALERT_ON_SUCCESS=0
REMOTE_COMPUTE_FAIL_ON_WATCH=0
# Production default: migrations run explicitly in deploy scripts, not at container boot.
RUN_MIGRATIONS_ON_START=0

# Homework Helper backend
# Options: "ollama" (default), "openai_compatible", "openai" (legacy Responses path), or "mock" (CI/test only)
# Day-1 deploy default: use the bundled CPU-local Ollama service.
# Set to 0 after moving `LLM_BASE_URL` to a remote/private backend.
COMPOSE_LOCAL_OLLAMA_AUTO=1
LLM_ENABLED=1
LLM_BACKEND=ollama
HELPER_LLM_BACKEND=ollama
# Production/private tailnet path:
# - keep browsers on the public LMS domain (`DOMAIN`)
# - point `LLM_BASE_URL` at a private tailnet-only HTTPS hostname
# - require a shared bearer token in `LLM_API_KEY`
# - for the current createMPLS deployment, Jetson_B runs Headscale at hs.creatempls.org
# - the serious class LLM lives on the Thundercompute vGPU tailnet endpoint
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=400
LLM_NUM_CTX=0
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_LOG_PROMPT_CONTENT=0
LLM_REDACTION_ENABLED=1
LLM_HEALTHCHECK_ENABLED=1
LLM_ALLOWED_ACTOR_TYPES=student,staff
# Optional: single YAML config source for helper behavior.
# When set, mapped helper settings can be read from this file.
# Environment variables still take precedence.
# Example template: compose/helper.config.example.yaml
HELPER_CONFIG_FILE=
# Safety gate: set to 1 only after confirming remote-helper data handling policy.
HELPER_REMOTE_MODE_ACKNOWLEDGED=0
CLASSHUB_REMOTE_HELPER_COMPUTE_ENABLED=0
CLASSHUB_REMOTE_HELPER_COMPUTE_ACKNOWLEDGED=0
HELPER_MOCK_RESPONSE_TEXT=
# Optional staff-only remote helper compute lease control.
# Keep off by default. When enabled, staff can activate remote compute for a
# bounded class window while students still use the public LMS as usual.
HELPER_REMOTE_COMPUTE_ENABLED=0
HELPER_REMOTE_COMPUTE_PROVIDER_ADAPTER=thunder_webhook
HELPER_REMOTE_COMPUTE_PROVIDER_LABEL=thunder-orchestration
HELPER_REMOTE_COMPUTE_ACTIVATE_URL=
HELPER_REMOTE_COMPUTE_DEACTIVATE_URL=
HELPER_REMOTE_COMPUTE_HEALTHCHECK_URL=
HELPER_REMOTE_COMPUTE_CONTROL_API_KEY=
HELPER_REMOTE_COMPUTE_CONTROL_TIMEOUT_SECONDS=8
CLASSHUB_REMOTE_HELPER_COMPUTE_IDLE_TIMEOUT_SECONDS=1800
HELPER_REMOTE_COMPUTE_READY_MAX_SECONDS=12
HELPER_REMOTE_COMPUTE_ESTIMATED_USD_PER_HOUR=
HELPER_INTERNAL_REMOTE_COMPUTE_STATUS_URL=http://helper_web:8000/helper/internal/remote-compute-status
HELPER_INTERNAL_REMOTE_COMPUTE_EVIDENCE_URL=http://helper_web:8000/helper/internal/remote-compute-evidence
HELPER_INTERNAL_REMOTE_COMPUTE_OPERATOR_SNAPSHOT_URL=http://helper_web:8000/helper/internal/remote-compute-operator-snapshot
HELPER_INTERNAL_REMOTE_COMPUTE_CONTROL_URL=http://helper_web:8000/helper/internal/remote-compute-control
HELPER_INTERNAL_REMOTE_COMPUTE_TIMEOUT_SECONDS=2
REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=
REMOTE_LLM_TIMEOUT_SECONDS=45
REMOTE_LLM_MAX_TOKENS=256
REMOTE_LLM_NUM_CTX=4096
REMOTE_LLM_TEMPERATURE=0.2
REMOTE_LLM_TOP_P=0.9
# When unset, strictness/scope/topic defaults are profile-driven by CLASSHUB_PROGRAM_PROFILE.
HELPER_STRICTNESS=light
HELPER_SCOPE_MODE=strict
HELPER_REFERENCE_DIR=/app/tutor/reference
HELPER_REFERENCE_MAP={"piper_scratch":"piper_scratch.md"}
HELPER_REFERENCE_FILE=/app/tutor/reference/piper_scratch.md
HELPER_SCOPE_TOKEN_MAX_AGE_SECONDS=7200
HELPER_RESPONSE_MAX_CHARS=2200
HELPER_CONVERSATION_ENABLED=1
HELPER_CONVERSATION_MAX_MESSAGES=12
HELPER_CONVERSATION_TTL_SECONDS=7200
HELPER_CONVERSATION_TURN_MAX_CHARS=1000
HELPER_CONVERSATION_HISTORY_MAX_CHARS=4000
HELPER_CONVERSATION_SUMMARY_MAX_CHARS=1400
HELPER_FOLLOW_UP_SUGGESTIONS_MAX=3
HELPER_MAX_CONCURRENCY=2
HELPER_QUEUE_MAX_WAIT_SECONDS=10
HELPER_QUEUE_POLL_SECONDS=0.2
HELPER_QUEUE_SLOT_TTL_SECONDS=120
# Keep helper worker timeout above (queue wait + retries * backend timeout + backoff).
HELPER_GUNICORN_TIMEOUT_SECONDS=180
HELPER_GUNICORN_WORKERS=2
HELPER_BACKEND_MAX_ATTEMPTS=2
HELPER_BACKOFF_SECONDS=0.4
HELPER_CIRCUIT_BREAKER_FAILURES=5
HELPER_CIRCUIT_BREAKER_TTL_SECONDS=30
HELPER_RATE_LIMIT_PER_MINUTE=30
HELPER_RATE_LIMIT_PER_IP_PER_MINUTE=90
HELPER_REQUIRE_CLASSHUB_TABLE=0
HELPER_REQUIRE_SCOPE_TOKEN_FOR_STAFF=0
HELPER_INTERNAL_API_TOKEN=REPLACE_ME_STRONG
HELPER_INTERNAL_RESET_URL=http://helper_web:8000/helper/internal/reset-class-conversations
HELPER_INTERNAL_ACTOR_CLEAR_URL=http://helper_web:8000/helper/internal/clear-actor-conversations
HELPER_INTERNAL_RESET_TIMEOUT_SECONDS=2
HELPER_INTERNAL_RAG_STATUS_URL=http://helper_web:8000/helper/internal/rag-status
HELPER_INTERNAL_RAG_STATUS_TIMEOUT_SECONDS=1.2
HELPER_INTERNAL_RESET_EXPORT_BEFORE_DELETE=1
HELPER_CLASS_RESET_MAX_KEYS=4000
HELPER_CLASS_RESET_ARCHIVE_ENABLED=0
HELPER_CLASS_RESET_ARCHIVE_DIR=/uploads/helper_reset_exports
HELPER_CLASS_RESET_ARCHIVE_MAX_MESSAGES=120
CLASSHUB_INTERNAL_EVENTS_URL=http://classhub_web:8000/internal/events/helper-chat-access
CLASSHUB_INTERNAL_EVENTS_TOKEN=REPLACE_ME_STRONG
CLASSHUB_INTERNAL_EVENTS_TIMEOUT_SECONDS=3
HELPER_TOPIC_FILTER_MODE=strict
HELPER_TEXT_LANGUAGE_KEYWORDS=pascal,python,java,javascript,typescript,c++,c#,csharp,ruby,php,go,golang,rust,swift,kotlin

# Ollama (local model server)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=0
OLLAMA_NUM_PREDICT=400
# Optional serious private-LLM production split:
# DOMAIN=lms.creatempls.org
# Jetson_B / Headscale: hs.creatempls.org
# Thundercompute vGPU model endpoint: thundercompute-vgpu.tail.creatempls.org
# LLM_BACKEND=openai_compatible
# LLM_BASE_URL=https://thundercompute-vgpu.tail.creatempls.org
# LLM_MODEL=REPLACE_ME_WITH_THUNDERCOMPUTE_MODEL_ID
# HELPER_RAG_EMBED_BASE_URL=https://thundercompute-vgpu.tail.creatempls.org
# Remote vGPU starting point for short helper replies:
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_PREDICT=64
# HELPER_REMOTE_MODE_ACKNOWLEDGED=1
# CLASSHUB_REMOTE_HELPER_COMPUTE_ENABLED=1
# CLASSHUB_REMOTE_HELPER_COMPUTE_ACKNOWLEDGED=1

# OpenAI (optional fallback)
OPENAI_API_KEY=__SET_ME__
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_OUTPUT_TOKENS=400

# Deploy smoke checks (used by scripts/smoke_check.sh --strict)
SMOKE_BASE_URL=https://lms.example.org
SMOKE_CLASS_CODE=ABCD1234
SMOKE_DISPLAY_NAME=Smoke Student
SMOKE_HELPER_MESSAGE=Give one short Scratch hint about moving a sprite.
SMOKE_TEACHER_USERNAME=teacher1
SMOKE_TEACHER_PASSWORD=CHANGE_ME
# Optional: pre-issued Django session key for /teach checks (used by golden smoke).
SMOKE_TEACHER_SESSION_KEY=
SMOKE_TIMEOUT_SECONDS=20
SMOKE_INSECURE_TLS=0
